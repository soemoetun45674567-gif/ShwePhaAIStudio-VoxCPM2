    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(
        data.error || `VoxCPM2 API Error ${response.status}`
      );
    }

    if (!data.audio) {
      throw new Error('No audio returned from VoxCPM2.');
    }

    return {
