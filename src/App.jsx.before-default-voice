             showToast(t("ဘာသာပြန်ရာတွင် အမှားအယွင်းဖြစ်ပွားခဲ့ပါသည်။ ပြန်လည်ကြိုးစားပါ။", "Translation failed after multiple retries."), "error");
             setIsTranslating(false);
